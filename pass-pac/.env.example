FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

POSTGRES_DB=pass_pac
POSTGRES_USER=pass_pac_user
POSTGRES_PASSWORD=pass_pac_password

DATABASE_URL=postgresql://pass_pac_user:pass_pac_password@postgres:5432/pass_pac
NEXT_PUBLIC_API_URL=http://localhost:8000

APP_MODE=simulator
REPORTS_DIR=/app/reports
MOCK_DATA_DIR=/app/mock-data
SIMULATOR_CARD_FILE=flipper-imported-cards.json

# Proxmark3 Easy 512K integration foundation.
# For Docker on Windows, run tools/proxmark_bridge.py on the host and use:
# PROXMARK_BRIDGE_URL=http://host.docker.internal:8765
# For a host-run backend, use your Windows pm3/proxmark3 client path and COM port directly.
PROXMARK_BRIDGE_URL=
PROXMARK_CLIENT_PATH=
PROXMARK_PORT=
PROXMARK_COMMAND_TIMEOUT_SECONDS=10
